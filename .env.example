# BrowseFleet Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Authentication (comma-separated API keys, empty = no auth required)
API_KEYS=

# Browser Pool
MAX_CONCURRENT_SESSIONS=30
DEFAULT_SESSION_TIMEOUT=1800000
MAX_SESSION_TIMEOUT=86400000
CHROME_PATH=

# Stealth (none | basic | full)
# 'none' = vanilla Chromium, 'basic'/'full' = CloakBrowser patched binary
STEALTH_DEFAULT=full

# CloakBrowser (auto-downloads stealth Chromium binary)
# Free key at https://cloakbrowser.dev/free (1 concurrent session, Chromium 146)
# Pro key at https://cloakbrowser.dev (unlimited sessions, Chromium 150, 71 patches)
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_AUTO_UPDATE=true

# Proxy (global fallback, per-session proxy overrides this)
PROXY_URL=

# CAPTCHA solving (2captcha)
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha

# CDP proxy (external hostname for constructing client-facing WebSocket URLs)
# For Cloudflare tunnel or reverse proxy setups:
#   CDP_EXTERNAL_HOST=browsefleet.yourdomain.com
#   CDP_EXTERNAL_PORT=443  (or 80 for HTTP)
#   CDP_EXTERNAL_SCHEME=wss (or ws for HTTP)
CDP_EXTERNAL_HOST=localhost
CDP_EXTERNAL_PORT=3000
CDP_EXTERNAL_SCHEME=ws

# AI Agent (for /v1/agent endpoint, vision-based browser automation)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Data directory (SQLite DB, profiles, temp files)
DATA_DIR=./data

# Logging
LOG_LEVEL=info
