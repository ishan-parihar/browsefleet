cmd_console() {
  case "${1:-}" in
    --help|-h)
      cat <<'EOF'
bf console — Read console log entries from a session

Usage: bf console <sid|prefix>

NOTE: this command requires the server to emit `console` events on the
SSE /v1/sessions/:id/events stream. The current server only emits
`snapshot` events, so this returns zero logs by design. Use bf axi
<sid> evaluate '() => console.history' to inspect the browser-side
console buffer over CDP.
EOF
      return ;;
  esac
  local sid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit|-n) shift 2 ;;
      --timeout|-t) shift 2 ;;
      *) sid="$1"; shift ;;
    esac
  done
  [ -z "$sid" ] && die "console requires a session ID"
  sid=$(resolve_sid "$sid")
  local raw; raw=$(timeout 2 "${CURL[@]}" -N --max-time 2 "$BF_URL/v1/sessions/$sid/events" 2>/dev/null || true)
  local count; count=$(echo "$raw" | awk '/^event: console/' | wc -l)
  toon_kv "session" "$sid" "logs" "$count"
  printf 'note: server currently only emits `snapshot` events on /events\n'
  printf 'hint: bf axi %s evaluate "() => console.log.length" reads the browser buffer\n' "$sid"
}

cmd_network() {
  case "${1:-}" in
    --help|-h)
      cat <<'EOF'
bf network — Read network requests from a session

Usage: bf network <sid|prefix>

NOTE: this command requires the server to emit `request` events on the
SSE /v1/sessions/:id/events stream. The current server only emits
`snapshot` events, so this returns zero requests by design. Use bf axi
<sid> evaluate '() => performance.getEntriesByType("resource").length'
to count browser-side network activity over CDP.
EOF
      return ;;
  esac
  local sid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit|-n) shift 2 ;;
      --timeout|-t) shift 2 ;;
      *) sid="$1"; shift ;;
    esac
  done
  [ -z "$sid" ] && die "network requires a session ID"
  sid=$(resolve_sid "$sid")
  local raw; raw=$(timeout 2 "${CURL[@]}" -N --max-time 2 "$BF_URL/v1/sessions/$sid/events" 2>/dev/null || true)
  local count; count=$(echo "$raw" | awk '/^event: request/' | wc -l)
  toon_kv "session" "$sid" "requests" "$count"
