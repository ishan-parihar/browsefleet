#!/usr/bin/env bash
# bf — BrowseFleet CLI for AI agents
# AXI-compliant interface to a remote BrowseFleet instance
# Usage: bf <command> [args] [flags]
set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────
BF_URL="${BROWSEFLEET_URL:-http://localhost:3000}"
BF_TOKEN="${BROWSEFLEET_TOKEN:-}"
BF_CDP_URL="${BROWSEFLEET_CDP_URL:-$BF_URL}"
CURL=(curl -sS --fail-with-body --max-time 120)
[ -n "$BF_TOKEN" ] && CURL+=(-H "x-api-key: $BF_TOKEN")

# ── TOON helpers ────────────────────────────────────────────────────
# ponytail: bare-minimum TOON output — no npm deps, just printf.
# Covers: objects, primitive arrays, tabular arrays, truncated strings.

toon_kv() {
  # toon_kv key1 val1 key2 val2 ...
  while [ $# -ge 2 ]; do
    local k="$1" v="$2"; shift 2
    # Quote strings that look like numbers/bools or contain special chars
    if [[ "$v" =~ ^[0-9.eE+-]+$ ]] || [[ "$v" =~ ^(true|false|null)$ ]] || [[ "$v" == *","* ]] || [[ "$v" == *":"* ]] || [[ "$v" == *\"* ]] || [[ -z "$v" ]]; then
      printf '%s: "%s"\n' "$k" "$v"
    else
      printf '%s: %s\n' "$k" "$v"
    fi
  done
}

# ── Validation helpers ──────────────────────────────────────────────
# Centralized flag validation so each command stays terse.

is_bool() {
  # is_bool <value>  →  returns 0 if value is true|false (case-insensitive)
  case "${1,,}" in
    true|false) return 0 ;;
    *) return 1 ;;
  esac
}

is_positive_int() {
  # is_positive_int <value>  →  returns 0 if value is a positive integer
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_int() {
  # is_int <value>  →  returns 0 if value is an integer (may be zero or negative)
  [[ "$1" =~ ^-?[0-9]+$ ]]
}

is_enum() {
  # is_enum <value> <allowed1> [allowed2 ...]
  local v="$1"; shift
  for allowed in "$@"; do
    [[ "$v" == "$allowed" ]] && return 0
  done
  return 1
}

toon_arr() {
  # toon_arr count val1 val2 ...
  local n=$1; shift
  printf '%s[%d]: %s\n' "${2:-items}" "$n" "$(IFS=,; echo "$*")"
  shift 2>/dev/null || true
}

toon_tab() {
  # toon_tab label count field1,field2 val1,val2 ...
  local label=$1 count=$2 fields=$3; shift 3
  printf '%s[%d]{%s}:\n' "$label" "$count" "$fields"
  for row in "$@"; do
    printf '  %s\n' "$row"
  done
}

trunc() {
  # trunc "string" max_chars — truncate with indicator
  local s="$1" max="${2:-500}"
  if [ ${#s} -le "$max" ]; then
    echo "$s"
  else
    printf '%s... (truncated, %d chars total)\n' "${s:0:$max}" "${#s}"
  fi
}

die() { printf 'error: %s\n' "$1" >&2; exit 1; }
usage_hint() { printf 'help: Run `bf %s --help` for usage\n' "$1" >&2; }

# ── API helpers ─────────────────────────────────────────────────────
# All helpers swallow curl's exit code (so `r=$(bf_get ...)` never trips set -e)
# but route through bf_curl so connection failures die with a clear message
# rather than silently returning an empty string.
bf_get() {
  local out rc=0
  out=$(bf_curl "${CURL[@]}" "$BF_URL$1") || rc=$?
  printf '%s' "$out"
  return 0
}
bf_post() {
  local body="${2:-}"
  [ -z "$body" ] && body="{}"
  local out rc=0
  out=$(bf_curl "${CURL[@]}" -X POST -H 'Content-Type: application/json' -d "$body" "$BF_URL$1") || rc=$?
  printf '%s' "$out"
  return 0
}
bf_del() {
  local out rc=0
  out=$(bf_curl "${CURL[@]}" -X DELETE "$BF_URL$1") || rc=$?
  printf '%s' "$out"
  return 0
}

# Surface {"error": "..."} payloads from any API response.
# Die on error; otherwise return silently so callers can assign r=$(...) cleanly.
check_error() {
  local r="$1"
  local err; err=$(echo "$r" | jq -r '.error // empty' 2>/dev/null)
  [ -n "$err" ] && die "server error: $err"
  return 0
}

# Run a curl invocation and die loudly if the host is unreachable.
# Distinguishes connection failures (curl exit 7) from HTTP error responses
# (curl exit 22) — the former almost always indicates a bad --url or
# downed BrowseFleet instance and should fail-fast.
bf_curl() {
  local args=("$@")
  local rc=0
  local out
  out=$("${args[@]}" 2>/dev/null) || rc=$?
  if [ "$rc" -eq 7 ]; then
    die "cannot reach $BF_URL (connection refused or DNS failure)"
  elif [ "$rc" -eq 6 ]; then
    die "cannot resolve host for $BF_URL"
  elif [ "$rc" -eq 28 ]; then
    die "request to $BF_URL timed out"
  fi
  printf '%s' "$out"
}

# ── Commands ────────────────────────────────────────────────────────

cmd_health() {
  case "${1:-}" in
    --help|-h)
      printf 'usage: bf health\ncheck BrowseFleet status\nreturns: status, version, uptime_sec\n'
      return ;;
  esac
  local r; r=$(bf_get /health)
  check_error "$r"
  local status=$(echo "$r" | jq -r '.status')
  local version=$(echo "$r" | jq -r '.version // "unknown"')
  local uptime=$(echo "$r" | jq -r '.uptime // 0')
  toon_kv "status" "$status" "version" "$version" "uptime_sec" "$uptime" "endpoint" "$BF_URL"
}

cmd_sessions() {
  local r; r=$(bf_get /v1/sessions)
  check_error "$r"
  local count=$(echo "$r" | jq '.sessions | length')
  [ "$count" -eq 0 ] && { printf 'sessions: 0 active sessions\n'; return; }
  echo "$r" | jq -r '.sessions[] | [.id, (.status // "active"), (.stealth // "-"), (.createdAt // "-")[0:19]] | @tsv' | \
    while IFS=$'\t' read -r id status fp created; do
      printf '  %s  %-10s  stealth=%s  %s\n' "$id" "$status" "$fp" "$created"
    done
  printf 'help: Run `bf session view <id>` for details\n'
}

# Resolve a session-id argument that may be a prefix (8+ hex chars) to the full UUID.
# Echoes the full id, or dies if zero/multiple matches.
resolve_sid() {
  local needle="$1"
  local r; r=$(bf_get /v1/sessions)
  check_error "$r"
  local matches; matches=$(echo "$r" | jq -r --arg n "$needle" \
    '[.sessions[] | select(.id | startswith($n)) | .id] | .[]')
  local n; n=$(echo "$matches" | grep -c . || true)
  case "$n" in
    0) die "no session matches prefix: $needle" ;;
    1) echo "$matches" ;;
    *) die "ambiguous prefix '$needle' matches $n sessions" ;;
  esac
}

cmd_session_create() {
  local fp="" proxy="" profile="" headless="true" timeout="" stealth="" cm="" sm="" vp=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --fingerprint|-f) fp="$2"; shift 2 ;;
      --proxy|-p) proxy="$2"; shift 2 ;;
      --profile) profile="$2"; shift 2 ;;
      --headless) headless="$2"; shift 2 ;;
      --timeout|-t) timeout="$2"; shift 2 ;;
      --stealth|-s) stealth="$2"; shift 2 ;;
      --control-mode) cm="$2"; shift 2 ;;
      --sensitive-mode) sm="$2"; shift 2 ;;
      --viewport) vp="$2"; shift 2 ;;
      --help|-h)
        cat <<'EOF'
bf session create — Create a new stealth browser session

Usage: bf session create [flags]

Flags:
  --fingerprint, -f <seed>   Per-session fingerprint seed (different = different identity)
  --proxy, -p <url>          Outbound proxy for this session
  --profile <id>             Reuse a saved Chrome user-data directory
  --headless <bool>          true (default) or false (operator mode)
  --timeout, -t <ms>         Session lifetime in milliseconds (positive integer)
  --stealth, -s <mode>       none | basic | full (default per STEALTH_DEFAULT)
  --control-mode <mode>      agent (default) | human | paused | operator
  --sensitive-mode <bool>    true | false (default)
  --viewport WxH             Viewport size, e.g. 1920x1080

Example:
  bf session create --fingerprint jp-tokyo-001 --headless true
EOF
        return ;;
      *) die "unknown flag $1 for session create" ;;
    esac
  done

  # Validate flags AFTER parsing so unknown-flag errors come first.
  if [ -n "$headless" ]; then
    is_bool "$headless" || die "--headless must be true or false, got '$headless'"
  fi
  if [ -n "$timeout" ]; then
    is_positive_int "$timeout" || die "--timeout must be a positive integer (ms), got '$timeout'"
  fi
  if [ -n "$stealth" ]; then
    is_enum "$stealth" none basic full || die "--stealth must be one of none|basic|full, got '$stealth'"
  fi
  if [ -n "$cm" ]; then
    is_enum "$cm" agent human paused operator || die "--control-mode must be one of agent|human|paused|operator, got '$cm'"
  fi
  if [ -n "$sm" ]; then
    is_bool "$sm" || die "--sensitive-mode must be true or false, got '$sm'"
  fi
  if [ -n "$vp" ]; then
    [[ "$vp" =~ ^[0-9]+x[0-9]+$ ]] || die "--viewport must match WxH (e.g. 1920x1080), got '$vp'"
  fi

  local body="{"
  [ -n "$fp" ] && body+="\"fingerprint\":\"$fp\","
  [ -n "$proxy" ] && body+="\"proxyUrl\":\"$proxy\","
  [ -n "$profile" ] && body+="\"profileId\":\"$profile\","
  [ -n "$stealth" ] && body+="\"stealth\":\"$stealth\","
  body+="\"headless\":$headless"
  [ -n "$timeout" ] && body+=",\"timeout\":$timeout"
  [ -n "$cm" ] && body+=",\"controlMode\":\"$cm\""
  [ -n "$sm" ] && body+=",\"sensitiveMode\":$sm"
  if [ -n "$vp" ]; then
    local w="${vp%x*}" h="${vp#*x}"
    body+=",\"viewport\":{\"width\":$w,\"height\":$h}"
  fi
  body+="}"

  local r; r=$(bf_post /v1/sessions "$body")
  check_error "$r"
  local id=$(echo "$r" | jq -r '.id')
  local cdp=$(echo "$r" | jq -r '.websocketUrl // empty')
  toon_kv "session_id" "$id" "cdp" "${cdp:-n/a}" "fingerprint" "${fp:-auto}" "headless" "$headless"
  printf 'help: Run `bf scrape --session %s <url>` to use this session\n' "$id"
}

cmd_session_view() {
  case "${1:-}" in
    --help|-h)
      printf 'usage: bf session view <id|prefix>\ninspect a session (accepts a unique ID prefix)\n'
      return ;;
  esac
  [ $# -eq 0 ] && die "session view requires a session ID"
  local id; id=$(resolve_sid "$1")
  local r; r=$(bf_get "/v1/sessions/$id")
  check_error "$r"
  toon_kv \
    "id"             "$(echo "$r" | jq -r '.id')" \
    "status"         "$(echo "$r" | jq -r '.status // "unknown"')" \
    "fingerprint"    "$(echo "$r" | jq -r '.fingerprint // "-"')" \
    "headless"       "$(echo "$r" | jq -r '.headless // "-"')" \
    "control_mode"   "$(echo "$r" | jq -r '.controlMode // "agent"')" \
    "sensitive_mode" "$(echo "$r" | jq -r '.sensitiveMode // false')" \
    "stealth"        "$(echo "$r" | jq -r '.stealth // "-"')" \
    "viewport"       "$(echo "$r" | jq -r '"\(.viewport.width)x\(.viewport.height)"')" \
    "operator_mode"  "$(echo "$r" | jq -r '.operatorMode // false')" \
    "created"        "$(echo "$r" | jq -r '.createdAt // "-"')" \
    "expires"        "$(echo "$r" | jq -r '.expiresAt // "-"')" \
    "cdp"            "$(echo "$r" | jq -r '.websocketUrl // "-"')" \
    "events"         "$(echo "$r" | jq -r '.eventsUrl // "-"')" \
    "viewer"         "$(echo "$r" | jq -r '.viewerUrl // "-"')"
}

cmd_session_release() {
  case "${1:-}" in
    --help|-h)
      printf 'usage: bf session release <id|prefix>\nrelease a browser session\n'
      return ;;
  esac
  [ $# -eq 0 ] && die "session release requires a session ID"
  local id; id=$(resolve_sid "$1")
  local r; r=$(bf_post "/v1/sessions/$id/release" "{}")
  check_error "$r"
  toon_kv "released" "$(echo "$r" | jq -r '.released')"
}

cmd_session_control() {
  case "${1:-}" in
    --help|-h)
      cat <<'EOF'
bf session control -- Switch a session's control mode

Usage: bf session control <id|prefix> <agent|human|paused>

Modes:
  agent    Autonomous AI-driven session (default at creation)
  human    Human operator (hijacks Chrome via VNC)
  paused   No actions until switched back

Example:
  bf session control abc12345 human
  bf session control abc12345 agent
EOF
      return ;;
  esac
  [ $# -lt 2 ] && die "control requires <id|prefix> <agent|human|paused>"
  local id; id=$(resolve_sid "$1")
  shift
  local mode="$1"
  case "$mode" in
    agent|human|paused) ;;
    *) die "invalid mode '$mode'; valid: agent, human, paused" ;;
  esac
  local r; r=$(bf_post "/v1/sessions/$id/control" "$(jq -cn --arg m "$mode" '{controlMode:$m}')")
  check_error "$r"
  local newmode; newmode=$(echo "$r" | jq -r '.controlMode // empty')
  if [ -z "$newmode" ]; then
    die "control response missing controlMode field: $(echo "$r" | head -c 200)"
  fi
  toon_kv "session" "$id" "control_mode" "$newmode"
}

cmd_files() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    --help|-h)
      cat <<'EOF'
bf session files -- Upload, list, download session files

Usage:
  bf session files list <id|prefix>
  bf session files upload <id|prefix> <local-path>
  bf session files download <id|prefix> <remote-name> <out-path>
EOF
      return ;;
    list)
      [ $# -lt 1 ] && die "files list requires a session ID"
      local id; id=$(resolve_sid "$1")
      local r; r=$(bf_get "/v1/sessions/$id/files")
      check_error "$r"
      echo "$r" | jq -r '.files[]? // .[]? // empty' | while IFS= read -r line; do
        printf '  %s\n' "$line"
      done
      ;;
    upload)
      [ $# -lt 2 ] && die "files upload requires <id|prefix> <local-path>"
      local id; id=$(resolve_sid "$1")
      local src="$2"
      [ -f "$src" ] || die "local file not found: $src"
      # Multipart with field name "file" -- browsefleet requires this.
      local r; r=$(curl -s -X POST -H "x-api-key: ${BROWSEFLEET_TOKEN:-}" -F "file=@${src}" "$BF_URL/v1/sessions/$id/files")
      check_error "$r"
      toon_kv "uploaded" "$(echo "$r" | jq -r '.uploaded // empty')" "size" "$(echo "$r" | jq -r '.size // empty')" "session" "$id"
      ;;
    download)
      [ $# -lt 3 ] && die "files download requires <id|prefix> <remote-name> <out-path>"
      local id; id=$(resolve_sid "$1")
      local name="$2"
      local out="$3"
      local rc=0
      "${CURL[@]}" "$BF_URL/v1/sessions/$id/files/$name" --output "$out" 2>/dev/null || rc=$?
      if [ "$rc" -eq 7 ] || [ "$rc" -eq 6 ]; then
        rm -f "$out"
        die "cannot reach $BF_URL"
      fi
      if [ -s "$out" ]; then
        local sz; sz=$(stat -c%s "$out" 2>/dev/null || stat -f%z "$out" 2>/dev/null)
        toon_kv "downloaded" "$out" "remote" "$name" "bytes" "$sz"
      else
        rm -f "$out"
        die "download failed — server returned no data (rc=$rc)"
      fi
      ;;
    *) die "unknown files subcommand '$sub'; valid: list, upload, download" ;;
  esac
}

cmd_captcha() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    --help|-h)
      cat <<'EOF'
bf session captcha -- Solve a CAPTCHA on the current page

Usage: bf session captcha solve <id|prefix>
EOF
      return ;;
    solve)
      [ $# -lt 1 ] && die "captcha solve requires a session ID"
      local id; id=$(resolve_sid "$1")
      local r; r=$(bf_post "/v1/sessions/$id/captcha/solve" "{}")
      check_error "$r"
      local ok type duration err
      ok=$(echo "$r" | jq -r '.success // empty')
      type=$(echo "$r" | jq -r '.type // empty')
      duration=$(echo "$r" | jq -r '.duration // empty')
      err=$(echo "$r" | jq -r '.error // empty')
      if [ -n "$err" ]; then
        toon_kv "session" "$id" "success" "$ok" "type" "$type" "duration" "$duration" "error" "$err"
      else
        toon_kv "session" "$id" "success" "$ok" "type" "$type" "duration" "$duration"
      fi
      [ "$ok" = "true" ] || die "captcha solve failed: $err"
      ;;
    *) die "unknown captcha subcommand '$sub'; valid: solve" ;;
  esac
}

cmd_agent() {
  case "${1:-}" in
    --help|-h)
      cat <<'EOF'
bf session agent -- Run an autonomous AI agent task

Usage: bf session agent <id|prefix> <task description>

The agent runs synchronously and returns steps taken. May take several seconds
to minutes depending on task complexity.
EOF
      return ;;
  esac
  [ $# -lt 2 ] && die "agent requires <id|prefix> <task>"
  local id; id=$(resolve_sid "$1")
  shift
  local task="$*"
  local r; r=$(bf_post "/v1/agent" "$(jq -cn --arg id "$id" --arg task "$task" '{session:$id, task:$task}')")
  check_error "$r"
  echo "$r" | jq -r '.steps[]? | "  - " + .action + ": " + (.result // "")' 2>/dev/null || echo "$r" | jq .
}



cmd_action() {
  # Allow `bf action --help` with no session id
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
bf action — Execute actions in a BrowseFleet session

Usage: bf action <session-id|prefix> [one action flag] | --json '<array>'

Flags:
  --navigate <url>       Navigate
  --click <x> <y>        Click coordinates
  --type <text>          Type text
  --key <key>            Press a key
  --scroll <pixels>      Scroll vertically
  --wait <milliseconds>  Wait
  --screenshot <path>    Capture a screenshot (path required to save)
  --json '<array>'       Send a raw action array

Only ONE action flag (other than --json) is allowed per call. Use
--json to send a batch of actions.

Examples:
  bf action <id> --navigate https://example.com
  bf action <id> --click 420 300
  bf action <id> --screenshot /tmp/shot.png
  bf action <id> --json '[{"type":"wait","duration":1000},{"type":"screenshot"}]'
EOF
    return
  fi
  [ $# -lt 1 ] && die "action requires a session ID"
  local sid; sid=$(resolve_sid "$1")
  shift
  local screenshot_path=""
  local actions="" json=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        [ -n "$actions" ] && die "only one action flag allowed; --json cannot combine with others"
        json="$2"; shift 2 ;;
      --navigate)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        actions=$(jq -cn --arg url "$2" '[{type:"navigate",url:$url}]'); shift 2 ;;
      --click)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        [ $# -lt 3 ] && die "--click requires <x> <y>"
        is_int "$2" || die "--click x must be an integer, got '$2'"
        is_int "$3" || die "--click y must be an integer, got '$3'"
        actions=$(jq -cn --argjson x "$2" --argjson y "$3" '[{type:"click",x:$x,y:$y}]'); shift 3 ;;
      --type)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        [ $# -lt 2 ] && die "--type requires <text>"
        actions=$(jq -cn --arg text "$2" '[{type:"type",text:$text}]'); shift 2 ;;
      --key)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        actions=$(jq -cn --arg key "$2" '[{type:"press_key",key:$key}]'); shift 2 ;;
      --scroll)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        is_int "$2" || die "--scroll must be an integer (pixel delta), got '$2'"
        actions=$(jq -cn --argjson dy "$2" '[{type:"scroll",deltaY:$dy}]'); shift 2 ;;
      --wait)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        is_int "$2" || die "--wait must be an integer (milliseconds), got '$2'"
        [ "$2" -lt 0 ] && die "--wait cannot be negative"
        actions=$(jq -cn --argjson duration "$2" '[{type:"wait",duration:$duration}]'); shift 2 ;;
      --screenshot)
        [ -n "$actions" ] && die "only one action flag allowed; use --json for batches"
        [ $# -lt 2 ] && die "--screenshot requires <path>"
        actions='[{"type":"screenshot"}]'; screenshot_path="$2"; shift 2 ;;
      --help|-h) cmd_action --help; return ;;
      *) die "unknown flag $1 for action; valid flags: --navigate, --click, --type, --key, --scroll, --wait, --screenshot, --json" ;;
    esac
  done
  [ -n "$json" ] && actions="$json"
  [ -z "$actions" ] && die "action requires one action flag or --json"
  echo "$actions" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1 || die "actions must be a non-empty JSON array"
  local r; r=$(bf_post "/v1/sessions/$sid/actions" "$(jq -cn --argjson actions "$actions" '{actions:$actions}')")
  check_error "$r"
  local count; count=$(echo "$r" | jq '.results | length')
  printf 'results: %s\n' "$count"
  local failed; failed=0
  local i=0
  while [ "$i" -lt "$count" ]; do
    local result; result=$(echo "$r" | jq -c ".results[$i]")
    local type success error
    type=$(echo "$result" | jq -r '.type')
    success=$(echo "$result" | jq -r '.success')
    error=$(echo "$result" | jq -r '.error // ""')
    printf '  - type: %s\n    success: %s\n    error: "%s"\n' "$type" "$success" "$error"
    if [ "$type" = "screenshot" ] && [ "$success" = "true" ] && [ -n "$screenshot_path" ]; then
      local img
      img=$(echo "$result" | jq -r '.screenshot // empty')
      if [ -n "$img" ] && [ "$img" != "null" ]; then
        if echo "$img" | base64 -d > "$screenshot_path" 2>/dev/null && [ -s "$screenshot_path" ]; then
          local sz; sz=$(stat -c%s "$screenshot_path" 2>/dev/null || stat -f%z "$screenshot_path" 2>/dev/null)
          printf '    saved: %s (%s bytes)\n' "$screenshot_path" "$sz"
        fi
      fi
    fi
    [ "$success" = "false" ] && failed=$((failed + 1))
    i=$((i + 1))
  done
  [ "$failed" -eq 0 ] || die "$failed action(s) failed"
}

cmd_axi() {
  # bf axi --help: show bf-level help (before any sid)
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
bf axi — Run chrome-devtools-axi against a session's CDP endpoint

Usage: bf axi <session-id|prefix> <axi-command> [args]

AXI must be installed globally for snappy invocations, or this will
auto-bootstrap via `npx -y chrome-devtools-axi` (slower first call).

Examples:
  bf axi <sid> open https://example.com
  bf axi <sid> snapshot
  bf axi <sid> click @e5
  bf axi <sid> type 'hello'
EOF
    return
  fi
  [ $# -lt 2 ] && die "axi requires a session ID and chrome-devtools-axi command"
  local sid; sid=$(resolve_sid "$1")
  shift
  local r; r=$(bf_get "/v1/sessions/$sid")
  check_error "$r"
  local ws; ws=$(echo "$r" | jq -r '.websocketUrl // empty')
  [ -z "$ws" ] && die "session not found or websocket URL unavailable"
  # BrowseFleet may advertise localhost while the agent reaches it through
  # Cloudflare. Keep the session path, but derive the public WS origin locally.
  local ws_origin="$BF_CDP_URL"
  case "$ws_origin" in
    https://*) ws_origin="wss://${ws_origin#https://}" ;;
    http://*) ws_origin="ws://${ws_origin#http://}" ;;
    ws://*|wss://*) ;;
    *) die "BROWSEFLEET_CDP_URL must start with http://, https://, ws://, or wss://" ;;
  esac
  ws="${ws_origin%/}/cdp/$sid"

  local headers='{}'
  [ -n "$BF_TOKEN" ] && headers=$(jq -cn --arg key "$BF_TOKEN" '{"x-api-key":$key}')
  local axi_session="browsefleet-${sid//[^a-zA-Z0-9_-]/-}"
  CHROME_DEVTOOLS_AXI_BROWSER_URL="$ws" \
  CHROME_DEVTOOLS_AXI_WS_HEADERS="$headers" \
  CHROME_DEVTOOLS_AXI_SESSION="$axi_session" \
  npx -y chrome-devtools-axi "$@"
}

cmd_scrape() {
  local url="" session="" format="markdown" waitfor="" waituntil="" fullpage="false"
  while [ $# -gt 0 ]; do
    case "$1" in
      --session|-s) session="$2"; shift 2 ;;
      --format|-f) format="$2"; shift 2 ;;
      --waitfor|-w) waitfor="$2"; shift 2 ;;
      --waituntil) waituntil="$2"; shift 2 ;;
      --fullpage) fullpage="true"; shift ;;
      --help|-h) cat <<'EOF'
bf scrape — Extract content from a URL

Usage: bf scrape [flags] <url>

Flags:
  --session, -s <id>    Use an existing session
  --format, -f <fmt>    Output format: markdown (default), html, text, links
  --waitfor, -w <sel>   Wait for CSS selector before extracting
  --waituntil <evt>     Wait for event: load, domcontentloaded, networkidle
  --fullpage            Capture full page (scrolls to bottom)

Examples:
  bf scrape https://example.com
  bf scrape -s abc123 -f html https://example.com
  bf scrape -w "#content" https://spa.example.com
EOF
        return ;;
      -*) die "unknown flag $1 for scrape" ;;
      *) url="$1"; shift ;;
    esac
  done
  [ -z "$url" ] && die "scrape requires a URL"
  if [ -n "$session" ]; then
    case "$session" in
      --help|-h|"") die "scrape --session requires an ID" ;;
    esac
    session=$(resolve_sid "$session")
  fi
  if [ -n "$format" ]; then
    is_enum "$format" markdown html text links || die "--format must be markdown|html|text|links, got '$format'"
  fi
  if [ -n "$waituntil" ]; then
    is_enum "$waituntil" load domcontentloaded networkidle networkidle0 networkidle2 || die "--waituntil must be load|domcontentloaded|networkidle[0|2], got '$waituntil'"
  fi

  local body; body=$(jq -cn \
    --arg url "$url" \
    --arg format "$format" \
    --argjson fullpage "$fullpage" \
    --arg waitfor "$waitfor" \
    --arg waituntil "$waituntil" \
    --arg session "$session" \
    '{url: $url, format: $format, fullPage: $fullpage} | if $waitfor != "" then . + {waitFor: $waitfor} else . end | if $waituntil != "" then . + {waitUntil: $waituntil} else . end | if $session != "" then . + {session: $session} else . end')

  local r; r=$(bf_post /v1/scrape "$body")
  check_error "$r"
  local code=$(echo "$r" | jq -r '.statusCode // .error // "unknown"')
  local title=$(echo "$r" | jq -r '.title // empty')

  case "$format" in
    markdown|text)
      local content=$(echo "$r" | jq -r '.markdown // .text // empty')
      local len=${#content}
      toon_kv "url" "$url" "status" "$code" "title" "${title:-n/a}" "chars" "$len"
      [ "$len" -gt 0 ] && trunc "$content" 1500
      ;;
    html)
      local content=$(echo "$r" | jq -r '.html // empty')
      local len=${#content}
      toon_kv "url" "$url" "status" "$code" "chars" "$len"
      [ "$len" -gt 0 ] && trunc "$content" 1500
      ;;
    links)
      local count=$(echo "$r" | jq '.links | length')
      toon_kv "url" "$url" "status" "$code" "links" "$count"
      [ "$count" -gt 0 ] && echo "$r" | jq -r '.links[:20][] | "\(.href)\t\(.text // "")"' | \
        while IFS=$'\t' read -r href text; do printf '  %s  %s\n' "$href" "$text"; done
      [ "$count" -gt 20 ] && printf 'help: %d more links truncated\n' "$((count-20))"
      ;;
    *)
      toon_kv "url" "$url" "status" "$code" "title" "${title:-n/a}"
      trunc "$(echo "$r" | jq -c '.' 2>/dev/null || echo "$r")" 1500
      ;;
  esac
}

cmd_screenshot() {
  local url="" outfile="" fullpage="false" session="" width="1280" height="900"
  while [ $# -gt 0 ]; do
    case "$1" in
      --fullpage) fullpage="true"; shift ;;
      --session|-s) session="$2"; shift 2 ;;
      --width|-W) width="$2"; shift 2 ;;
      --height|-H) height="$2"; shift 2 ;;
      --help|-h) cat <<'EOF'
bf screenshot — Capture a screenshot

Usage: bf screenshot [flags] <url> [output.png]

Flags:
  --fullpage        Capture full scrollable page
  --session, -s <id>  Use an existing session
  --width, -W <px>  Viewport width (default: 1280)
  --height, -H <px> Viewport height (default: 900)

Examples:
  bf screenshot https://example.com output.png
  bf screenshot --fullpage https://example.com full.png
EOF
        return ;;
      -*) die "unknown flag $1 for screenshot" ;;
      *)
        if [ -z "$url" ]; then url="$1"
        elif [ -z "$outfile" ]; then outfile="$1"
        fi
        shift ;;
    esac
  done
  [ -z "$url" ] && die "screenshot requires a URL"
  if [ -n "$session" ]; then
    session=$(resolve_sid "$session")
  fi
  is_positive_int "$width" || die "--width must be a positive integer, got '$width'"
  is_positive_int "$height" || die "--height must be a positive integer, got '$height'"
  [ -z "$outfile" ] && outfile="/tmp/bf-screenshot-$(date +%s).png"

  local body; body=$(jq -cn \
    --arg url "$url" \
    --argjson fullpage "$fullpage" \
    --argjson width "$width" \
    --argjson height "$height" \
    --arg session "$session" \
    '{url:$url, fullPage:$fullpage, viewport:{width:$width, height:$height}} | if $session != "" then . + {session:$session} else . end')
  "${CURL[@]}" -X POST -H 'Content-Type: application/json' -d "$body" "$BF_URL/v1/screenshot" --output "$outfile" 2>/dev/null

  if file "$outfile" | grep -q "PNG image"; then
    local size=$(stat -c%s "$outfile" 2>/dev/null || stat -f%z "$outfile" 2>/dev/null)
    toon_kv "saved" "$outfile" "format" "PNG" "bytes" "$size" "url" "$url"
  else
    rm -f "$outfile"
    die "screenshot failed — server returned non-PNG"
  fi
}

cmd_pdf() {
  local url="" outfile="" session=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session|-s) session="$2"; shift 2 ;;
      --help|-h) cat <<'EOF'
bf pdf — Generate a PDF from a URL

Usage: bf pdf [flags] <url> [output.pdf]

Examples:
  bf pdf https://example.com report.pdf
EOF
        return ;;
      -*) die "unknown flag $1 for pdf" ;;
      *)
        if [ -z "$url" ]; then url="$1"
        elif [ -z "$outfile" ]; then outfile="$1"
        fi
        shift ;;
    esac
  done
  [ -z "$url" ] && die "pdf requires a URL"
  [ -n "$session" ] && session=$(resolve_sid "$session")
  [ -z "$outfile" ] && outfile="/tmp/bf-pdf-$(date +%s).pdf"

  local body; body=$(jq -cn --arg url "$url" --arg session "$session" \
    '{url:$url} | if $session != "" then . + {session:$session} else . end')
  "${CURL[@]}" -X POST -H 'Content-Type: application/json' -d "$body" "$BF_URL/v1/pdf" --output "$outfile" 2>/dev/null

  if file "$outfile" | grep -qi "pdf"; then
    local size=$(stat -c%s "$outfile" 2>/dev/null || stat -f%z "$outfile" 2>/dev/null)
    toon_kv "saved" "$outfile" "format" "PDF" "bytes" "$size" "url" "$url"
  else
    rm -f "$outfile"
    die "pdf generation failed"
  fi
}

cmd_click() {
  case "${1:-}" in
    --help|-h)
      cat <<'EOF'
bf click — Click at x,y coordinates in a session

Usage: bf click <sid|prefix> <x> <y>

Note: the actions API uses mouse coordinates, not CSS selectors.
To click a CSS element, get its bounding box via AXI and feed the
coordinates here. Example:
  bf axi <sid> snapshot
  bf click <sid> 420 300
EOF
      return ;;
  esac
  [ $# -lt 3 ] && die "click requires a session ID, x, and y"
  local sid; sid=$(resolve_sid "$1")
  local x="$2" y="$3"
  is_int "$x" || die "click x must be an integer, got '$x'"
  is_int "$y" || die "click y must be an integer, got '$y'"
  local body; body=$(jq -cn --argjson x "$x" --argjson y "$y" '{actions:[{type:"click",x:$x,y:$y}]}')
  local r; r=$(bf_post "/v1/sessions/$sid/actions" "$body")
  check_error "$r"
  local ok; ok=$(echo "$r" | jq -r '.results[0].success')
  toon_kv "session" "$sid" "clicked" "[$x,$y]" "success" "$ok"
  if [ "$ok" != "true" ]; then
    local err; err=$(echo "$r" | jq -r '.results[0].error // "unknown"')
    die "click failed: $err"
  fi
}

