# ── Router ──────────────────────────────────────────────────────────

[ $# -eq 0 ] && { cmd_help; exit 0; }

# Global flags
while [ $# -gt 0 ]; do
  case "${1:-}" in
    -v|--version) echo "bf 0.1.0"; exit 0 ;;
    -h|--help) cmd_help; exit 0 ;;
    --url) BF_URL="$2"; BF_CDP_URL="${BROWSEFLEET_CDP_URL:-$BF_URL}"; CURL=(curl -sS --fail-with-body --max-time 120); [ -n "$BF_TOKEN" ] && CURL+=(-H "x-api-key: $BF_TOKEN"); shift 2 ;;
    --token) BF_TOKEN="$2"; CURL=(curl -sS --fail-with-body --max-time 120); [ -n "$BF_TOKEN" ] && CURL+=(-H "x-api-key: $BF_TOKEN"); shift 2 ;;
    *) break ;;
  esac
done

cmd="${1:-help}"; shift

case "$cmd" in
  health)
    case "${1:-}" in
      --help|-h) cmd_health --help; exit 0 ;;
    esac
    cmd_health "$@" ;;
  sessions)
    case "${1:-}" in
      --help|-h) printf 'usage: bf sessions\nlist active browser sessions on the server\n'; exit 0 ;;
    esac
    cmd_sessions "$@" ;;
  session)
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      --help|-h|"") cat <<'USAGE_EOF'
bf session -- Manage browser sessions

Usage: bf session <subcommand> [args]

Subcommands:
  create [flags]       Create a new browser session
  view <id|prefix>     Inspect a session
  release <id|prefix>  Release a session
  control <id> <mode>  Switch control mode (agent|human|paused)
  files <subcommand>   Upload, list, or download session files
  captcha solve <id>   Solve a CAPTCHA on the current page
  agent <id> <task>    Run an autonomous AI agent task

Run `bf session <subcommand> --help` for subcommand details.
USAGE_EOF
        exit 0 ;;
      create)  cmd_session_create "$@" ;;
      view)    cmd_session_view "$@" ;;
      release) cmd_session_release "$@" ;;
      control) cmd_session_control "$@" ;;
      files)   cmd_files "$@" ;;
      captcha) cmd_captcha "$@" ;;
      agent)   cmd_agent "$@" ;;
      *) die "$(printf 'unknown session subcommand: %s\nhelp: valid: create, view, release, control, files, captcha, agent' "$sub")" ;;
    esac ;;
  scrape)        cmd_scrape "$@" ;;
  action)        cmd_action "$@" ;;
  axi)           cmd_axi "$@" ;;
  screenshot)    cmd_screenshot "$@" ;;
  pdf)           cmd_pdf "$@" ;;
  click)         cmd_click "$@" ;;
  fill)          cmd_fill "$@" ;;
  navigate)      cmd_navigate "$@" ;;
  console)       cmd_console "$@" ;;
  network)       cmd_network "$@" ;;
  *) die "$(printf 'unknown command: %s\nhelp: Run '"'"'bf --help'"'"' for available commands' "$cmd")" ;;
esac
